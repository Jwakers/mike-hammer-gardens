# Required for an indexable production deployment. Use the confirmed canonical
# HTTPS origin with no path, for example: https://confirmed-domain.example
SITE_URL=

# Set to "production" when hosting outside Vercel. On Vercel, VERCEL_ENV is used.
SITE_ENV=development

# Public search-engine ownership tokens (optional until verified).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Set to "true" only on a paid Formspree plan that supports file uploads.
# Defaults to false when unset.
FORMSPREE_FILE_UPLOADS=false
